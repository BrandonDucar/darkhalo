{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "darkhalo",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-08",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/health", "/api/*", "/.well-known/darkhalo.json"],
    "not_found_handling": "none"
  }
}
